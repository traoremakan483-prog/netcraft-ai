# ─── Database (Supabase Postgres) ───
# Use the "Connection string" → "URI" from your Supabase project settings.
# For Prisma, use the pooled connection on port 6543 with ?pgbouncer=true for
# the runtime, and the direct connection (port 5432) as DIRECT_URL for migrations.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=public"

# ─── NextAuth v5 (Auth.js) ───
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Optional in v5 when using Vercel — required locally for non-standard URLs:
NEXTAUTH_URL="http://localhost:3000"

# ─── Google OAuth ───
# https://console.cloud.google.com/ → Credentials → OAuth 2.0 Client ID
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
